                  "datasetName": "total_budget",
                  "fields": [
                    {
                      "name": "budget_m",
                      "expression": "`budget_m`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
