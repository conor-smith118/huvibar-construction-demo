{
  "datasets": [
    {
      "name": "kpi_budget",
      "displayName": "Total Budget",
      "query": "SELECT ROUND(SUM(current_budget)/1000000,1) AS budget_m FROM css_genie.cost_reporting.budget_line_items b JOIN css_genie.project_tracking.projects p ON b.project_id=p.project_id WHERE p.status='active'"
    },
    {
      "name": "kpi_actuals",
      "displayName": "Total Actuals",
      "query": "SELECT ROUND(SUM(amount)/1000000,1) AS actuals_m FROM css_genie.cost_reporting.actual_costs ac JOIN css_genie.project_tracking.projects p ON ac.project_id=p.project_id WHERE p.status='active'"
    },
    {
      "name": "kpi_cos",
      "displayName": "Approved COs",
      "query": "SELECT ROUND(SUM(amount)/1000000,2) AS co_m FROM css_genie.cost_reporting.change_orders WHERE status='approved'"
    },
    {
      "name": "kpi_commits",
      "displayName": "Committed Costs",
      "query": "SELECT ROUND(SUM(committed_amount)/1000000,1) AS committed_m FROM css_genie.cost_reporting.committed_costs cc JOIN css_genie.project_tracking.projects p ON cc.project_id=p.project_id WHERE p.status='active'"
    },
    {
      "name": "cost_by_type",
      "displayName": "Actuals by Type",
      "query": "SELECT cost_type, ROUND(SUM(amount)/1000000,2) AS total_m FROM css_genie.cost_reporting.actual_costs ac JOIN css_genie.project_tracking.projects p ON ac.project_id=p.project_id WHERE p.status='active' GROUP BY cost_type ORDER BY total_m DESC"
    },
    {
      "name": "monthly_burn",
      "displayName": "Monthly Burn Rate",
      "query": "SELECT date_format(date_trunc('month',transaction_date),'yyyy-MM') AS month, ROUND(SUM(amount)/1000000,2) AS spend_m FROM css_genie.cost_reporting.actual_costs ac JOIN css_genie.project_tracking.projects p ON ac.project_id=p.project_id WHERE p.status='active' AND transaction_date >= add_months(current_date(),-12) GROUP BY month ORDER BY month"
    },
    {
      "name": "bva_by_proj",
      "displayName": "Budget vs Actual",
      "query": "SELECT p.project_name, ROUND(SUM(b.current_budget)/1000000,1) AS budget_m, ROUND(SUM(ac.amount)/1000000,1) AS actual_m FROM css_genie.project_tracking.projects p LEFT JOIN css_genie.cost_reporting.budget_line_items b ON p.project_id=b.project_id LEFT JOIN css_genie.cost_reporting.actual_costs ac ON p.project_id=ac.project_id WHERE p.status='active' GROUP BY p.project_name ORDER BY budget_m DESC"
    },
    {
      "name": "co_by_type",
      "displayName": "COs by Reason",
      "query": "SELECT reason_code, COUNT(*) AS cnt, ROUND(SUM(amount)/1000000,2) AS total_m FROM css_genie.cost_reporting.change_orders WHERE status='approved' GROUP BY reason_code ORDER BY total_m DESC"
    },
    {
      "name": "co_by_proj",
      "displayName": "COs by Project",
      "query": "SELECT p.project_name, ROUND(SUM(co.amount)/1000000,2) AS co_m FROM css_genie.cost_reporting.change_orders co JOIN css_genie.project_tracking.projects p ON co.project_id=p.project_id WHERE co.status='approved' GROUP BY p.project_name ORDER BY co_m DESC LIMIT 8"
    },
    {
      "name": "vendor_spend",
      "displayName": "Top Vendors",
      "query": "SELECT vendor_name, ROUND(SUM(amount)/1000000,2) AS spend_m FROM css_genie.cost_reporting.actual_costs ac JOIN css_genie.project_tracking.projects p ON ac.project_id=p.project_id WHERE p.status='active' AND cost_type='sub' GROUP BY vendor_name ORDER BY spend_m DESC LIMIT 10"
    }
  ],
