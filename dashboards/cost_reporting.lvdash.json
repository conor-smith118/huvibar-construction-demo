{
  "datasets": [
    {
      "name": "total_budget",
      "displayName": "Total Budget",
      "query": "SELECT ROUND(SUM(current_budget)/1000000,1) AS budget_m FROM css_genie.cost_reporting.budget_line_items b JOIN css_genie.project_tracking.projects p ON b.project_id = p.project_id WHERE p.status = 'active'"
    },
    {
      "name": "total_actuals",
      "displayName": "Total Actuals",
      "query": "SELECT ROUND(SUM(amount)/1000000,1) AS actuals_m FROM css_genie.cost_reporting.actual_costs ac JOIN css_genie.project_tracking.projects p ON ac.project_id = p.project_id WHERE p.status = 'active'"
    },
    {
      "name": "approved_cos",
      "displayName": "Approved Change Orders",
      "query": "SELECT ROUND(SUM(amount)/1000000,2) AS co_value_m FROM css_genie.cost_reporting.change_orders WHERE status = 'approved'"
    },
    {
      "name": "budget_vs_actual",
      "displayName": "Budget vs Actual",
      "query": "SELECT p.project_name, ROUND(SUM(b.current_budget)/1000000,2) AS budget_m, ROUND(SUM(ac.amount)/1000000,2) AS actual_m FROM css_genie.project_tracking.projects p LEFT JOIN css_genie.cost_reporting.budget_line_items b ON p.project_id = b.project_id LEFT JOIN css_genie.cost_reporting.actual_costs ac ON p.project_id = ac.project_id WHERE p.status = 'active' GROUP BY p.project_name ORDER BY budget_m DESC"
    },
    {
      "name": "monthly_burn",
      "displayName": "Monthly Burn",
      "query": "SELECT date_format(date_trunc('month', transaction_date), 'yyyy-MM') AS month, cost_type, ROUND(SUM(amount)/1000,0) AS amount_k FROM css_genie.cost_reporting.actual_costs WHERE transaction_date >= add_months(current_date(), -12) GROUP BY month, cost_type ORDER BY month"
    }
  ],
  "pages": [
    {
      "name": "cost_reporting",
      "displayName": "Cost & Budget",
      "layout": [
        {
          "widget": {
            "name": "w_budget",
            "title": "Total Budget ($M)",
