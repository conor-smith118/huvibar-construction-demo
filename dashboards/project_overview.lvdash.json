{
  "datasets": [
    {
      "name": "kpi_active",
      "displayName": "Active Projects",
      "queryLines": [
        "SELECT COUNT(*) AS count FROM css_genie.project_tracking.projects WHERE status = 'active'"
      ]
    },
    {
      "name": "kpi_value",
      "displayName": "Portfolio Value $M",
      "queryLines": [
        "SELECT ROUND(SUM(contract_value)/1000000,1) AS value_m FROM css_genie.project_tracking.projects WHERE status IN ('active','closeout')"
      ]
    },
    {
      "name": "kpi_rfis",
      "displayName": "Open RFIs",
      "queryLines": [
        "SELECT COUNT(*) AS rfi_count FROM css_genie.project_tracking.rfis WHERE status = 'open'"
      ]
    },
    {
      "name": "kpi_subs",
      "displayName": "Pending Submittals",
      "queryLines": [
        "SELECT COUNT(*) AS sub_count FROM css_genie.project_tracking.submittals WHERE status IN ('pending','revise_resubmit')"
      ]
    },
    {
      "name": "value_by_type",
      "displayName": "Value by Type",
      "queryLines": [
        "SELECT project_type, ROUND(SUM(contract_value)/1000000,1) AS value_m FROM css_genie.project_tracking.projects GROUP BY project_type ORDER BY value_m DESC"
      ]
    },
    {
      "name": "status_split",
      "displayName": "Projects by Status",
      "queryLines": [
        "SELECT status, COUNT(*) AS cnt FROM css_genie.project_tracking.projects GROUP BY status ORDER BY cnt DESC"
      ]
    },
    {
      "name": "pct_complete",
      "displayName": "Pct Complete",
      "queryLines": [
        "SELECT project_name, ROUND(percent_complete,1) AS pct_complete FROM css_genie.project_tracking.projects WHERE status IN ('active','closeout') ORDER BY pct_complete DESC LIMIT 12"
      ]
    },
    {
      "name": "rfi_by_proj",
      "displayName": "RFIs by Project",
      "queryLines": [
        "SELECT p.project_name, COUNT(r.rfi_id) AS open_rfis FROM css_genie.project_tracking.rfis r JOIN css_genie.project_tracking.projects p ON r.project_id=p.project_id WHERE r.status='open' GROUP BY p.project_name ORDER BY open_rfis DESC LIMIT 10"
      ]
    },
    {
      "name": "rfi_aging",
      "displayName": "RFI Age Buckets",
      "queryLines": [
        "SELECT CASE WHEN days_open>21 THEN 'Critical >21d' WHEN days_open>=14 THEN 'High 14-21d' WHEN days_open>=7 THEN 'Elevated 7-13d' ELSE 'Watch <7d' END AS urgency, COUNT(*) AS cnt FROM css_genie.project_tracking.rfis WHERE status='open' GROUP BY urgency ORDER BY cnt DESC"
      ]
    },
    {
      "name": "proj_started",
      "displayName": "Projects Started by Qtr",
      "queryLines": [
        "SELECT date_format(date_trunc('quarter',start_date),'yyyy-Qq') AS quarter, COUNT(*) AS started FROM css_genie.project_tracking.projects GROUP BY quarter ORDER BY quarter"
      ]
    }
  ],
