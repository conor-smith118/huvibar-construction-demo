{
  "datasets": [
    {
      "name": "kpi_active",
      "displayName": "Active Projects",
      "query": "SELECT COUNT(*) AS count FROM css_genie.project_tracking.projects WHERE status = 'active'"
    },
    {
      "name": "kpi_value",
      "displayName": "Portfolio Value",
      "query": "SELECT ROUND(SUM(contract_value)/1000000, 1) AS value_m FROM css_genie.project_tracking.projects WHERE status IN ('active','closeout')"
    },
    {
      "name": "kpi_rfis",
      "displayName": "Open RFIs",
      "query": "SELECT COUNT(*) AS rfi_count FROM css_genie.project_tracking.rfis WHERE status = 'open'"
    },
    {
      "name": "kpi_submittals",
      "displayName": "Pending Submittals",
      "query": "SELECT COUNT(*) AS sub_count FROM css_genie.project_tracking.submittals WHERE status IN ('pending','revise_resubmit')"
    },
    {
      "name": "value_by_type",
      "displayName": "Value by Type",
      "query": "SELECT project_type, ROUND(SUM(contract_value)/1000000,1) AS value_m FROM css_genie.project_tracking.projects GROUP BY project_type ORDER BY value_m DESC"
    },
    {
      "name": "status_split",
      "displayName": "Projects by Status",
      "query": "SELECT status, COUNT(*) AS cnt FROM css_genie.project_tracking.projects GROUP BY status ORDER BY cnt DESC"
    },
    {
      "name": "pct_complete",
      "displayName": "% Complete by Project",
      "query": "SELECT project_name, ROUND(percent_complete,1) AS pct_complete, contract_value, status FROM css_genie.project_tracking.projects WHERE status IN ('active','closeout') ORDER BY contract_value DESC LIMIT 12"
    },
    {
      "name": "rfi_by_proj",
      "displayName": "Open RFIs by Project",
      "query": "SELECT p.project_name, COUNT(r.rfi_id) AS open_rfis, MAX(r.days_open) AS max_days_open FROM css_genie.project_tracking.rfis r JOIN css_genie.project_tracking.projects p ON r.project_id = p.project_id WHERE r.status = 'open' GROUP BY p.project_name ORDER BY open_rfis DESC LIMIT 10"
    },
    {
      "name": "projects_started",
      "displayName": "Projects Started by Quarter",
      "query": "SELECT date_format(date_trunc('quarter', start_date),'yyyy-Qq') AS quarter, COUNT(*) AS started, ROUND(SUM(contract_value)/1000000,1) AS value_m FROM css_genie.project_tracking.projects GROUP BY quarter ORDER BY quarter"
    },
    {
      "name": "rfi_aging",
      "displayName": "RFI Aging Breakdown",
      "query": "SELECT CASE WHEN days_open > 21 THEN 'Critical (>21d)' WHEN days_open >= 14 THEN 'High (14-21d)' WHEN days_open >= 7 THEN 'Elevated (7-13d)' ELSE 'Watch (<7d)' END AS urgency, COUNT(*) AS count FROM css_genie.project_tracking.rfis WHERE status = 'open' GROUP BY urgency ORDER BY count DESC"
    }
  ],
