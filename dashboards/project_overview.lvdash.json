{
  "datasets": [
    {
      "name": "active_projects",
      "displayName": "Active Projects",
      "query": "SELECT COUNT(*) AS count FROM css_genie.project_tracking.projects WHERE status = 'active'"
    },
    {
      "name": "total_value",
      "displayName": "Total Contract Value",
      "query": "SELECT ROUND(SUM(contract_value)/1000000,1) AS total_value_m FROM css_genie.project_tracking.projects WHERE status IN ('active','closeout')"
    },
    {
      "name": "open_rfis",
      "displayName": "Open RFIs",
      "query": "SELECT COUNT(*) AS count FROM css_genie.project_tracking.rfis WHERE status = 'open'"
    },
    {
      "name": "overdue_submittals",
      "displayName": "Overdue Submittals",
      "query": "SELECT COUNT(*) AS count FROM css_genie.project_tracking.submittals WHERE status IN ('pending','revise_resubmit') AND required_date < current_date()"
    },
    {
      "name": "projects_by_type",
      "displayName": "Projects by Type",
      "query": "SELECT project_type, COUNT(*) AS project_count FROM css_genie.project_tracking.projects GROUP BY project_type ORDER BY project_count DESC"
    },
    {
      "name": "project_list",
      "displayName": "Project List",
      "query": "SELECT project_name, project_type, ROUND(contract_value/1000000,2) AS value_m, status, project_manager, superintendent, percent_complete FROM css_genie.project_tracking.projects ORDER BY contract_value DESC"
    },
    {
      "name": "rfis_by_project",
      "displayName": "Open RFIs by Project",
      "query": "SELECT p.project_name, COUNT(r.rfi_id) AS open_rfis FROM css_genie.project_tracking.rfis r JOIN css_genie.project_tracking.projects p ON r.project_id = p.project_id WHERE r.status = 'open' GROUP BY p.project_name ORDER BY open_rfis DESC"
    }
  ],
