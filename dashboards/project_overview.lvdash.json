{
  "datasets": [
    {
      "name": "kpi_active",
      "displayName": "KPI Active Projects",
      "query": "SELECT COUNT(*) AS active_count FROM css_genie.project_tracking.projects WHERE status = 'active'"
    },
    {
      "name": "kpi_portfolio_value",
      "displayName": "KPI Portfolio Value",
      "query": "SELECT ROUND(SUM(contract_value)/1000000, 1) AS value_m FROM css_genie.project_tracking.projects WHERE status IN ('active','closeout')"
    },
    {
      "name": "kpi_open_rfis",
      "displayName": "KPI Open RFIs",
      "query": "SELECT COUNT(*) AS rfi_count FROM css_genie.project_tracking.rfis WHERE status = 'open'"
    },
    {
      "name": "kpi_pending_submittals",
      "displayName": "KPI Pending Submittals",
      "query": "SELECT COUNT(*) AS submittal_count FROM css_genie.project_tracking.submittals WHERE status IN ('pending','revise_resubmit')"
    },
    {
      "name": "contract_by_type",
      "displayName": "Contract by Project Type",
      "query": "SELECT project_type, ROUND(SUM(contract_value)/1000000,1) AS value_m, COUNT(*) AS project_count FROM css_genie.project_tracking.projects GROUP BY project_type ORDER BY value_m DESC"
    },
    {
      "name": "portfolio_completion",
      "displayName": "Portfolio Completion",
      "query": "SELECT project_name, ROUND(contract_value/1000000,1) AS value_m, ROUND(percent_complete,0) AS pct_complete, status FROM css_genie.project_tracking.projects WHERE status IN ('active','closeout') ORDER BY contract_value DESC"
    },
    {
      "name": "rfi_by_project",
      "displayName": "RFIs by Project",
      "query": "SELECT p.project_name, COUNT(r.rfi_id) AS open_rfis, AVG(r.days_open) AS avg_days_open FROM css_genie.project_tracking.rfis r JOIN css_genie.project_tracking.projects p ON r.project_id = p.project_id WHERE r.status = 'open' GROUP BY p.project_name ORDER BY open_rfis DESC LIMIT 10"
    },
    {
      "name": "projects_by_status",
      "displayName": "Projects by Status",
      "query": "SELECT status, COUNT(*) AS cnt, ROUND(SUM(contract_value)/1000000,1) AS value_m FROM css_genie.project_tracking.projects GROUP BY status ORDER BY cnt DESC"
    }
  ],
  "pages": [
    {
      "name": "project_overview_page",
      "displayName": "Huvibar | Project Overview",
      "layout": [
        {
          "widget": {
            "name": "counter_active",
            "title": "Active Projects",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpi_active",
                  "fields": [
                    {"name": "active_count", "expression": "`active_count`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "active_count", "displayName": "Active Projects"}
              }
            }
          },
          "position": {"x": 0, "y": 0, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "counter_value",
            "title": "Portfolio Value",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpi_portfolio_value",
                  "fields": [
                    {"name": "value_m", "expression": "`value_m`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "value_m",
                  "displayName": "$M",
                  "numberFormat": {"type": "number"}
                }
              }
            }
          },
          "position": {"x": 2, "y": 0, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "counter_rfis",
            "title": "Open RFIs",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpi_open_rfis",
                  "fields": [
                    {"name": "rfi_count", "expression": "`rfi_count`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "rfi_count", "displayName": "Open RFIs"}
              }
            }
          },
          "position": {"x": 4, "y": 0, "width": 1, "height": 3}
        },
        {
          "widget": {
            "name": "counter_submittals",
            "title": "Pending Submittals",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpi_pending_submittals",
                  "fields": [
                    {"name": "submittal_count", "expression": "`submittal_count`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "submittal_count", "displayName": "Pending Submittals"}
              }
            }
          },
          "position": {"x": 5, "y": 0, "width": 1, "height": 3}
        },
        {
          "widget": {
            "name": "bar_by_type",
            "title": "Contract Value by Project Type ($M)",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "contract_by_type",
                  "fields": [
                    {"name": "project_type", "expression": "`project_type`"},
                    {"name": "value_m", "expression": "`value_m`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "project_type", "displayName": "Project Type"},
                "y": {"fieldName": "value_m", "displayName": "Value ($M)"}
              }
            }
          },
          "position": {"x": 0, "y": 3, "width": 3, "height": 5}
        },
        {
          "widget": {
            "name": "pie_status",
            "title": "Projects by Status",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "projects_by_status",
                  "fields": [
                    {"name": "status", "expression": "`status`"},
                    {"name": "cnt", "expression": "`cnt`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "pie",
              "encodings": {
                "label": {"fieldName": "status", "displayName": "Status"},
                "value": {"fieldName": "cnt", "displayName": "Count"}
              }
            }
          },
          "position": {"x": 3, "y": 3, "width": 3, "height": 5}
        },
        {
          "widget": {
            "name": "bar_rfis",
            "title": "Open RFIs by Project (Top 10)",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "rfi_by_project",
                  "fields": [
                    {"name": "project_name", "expression": "`project_name`"},
                    {"name": "open_rfis", "expression": "`open_rfis`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "project_name", "displayName": "Project"},
                "y": {"fieldName": "open_rfis", "displayName": "Open RFIs"}
              }
            }
          },
          "position": {"x": 0, "y": 8, "width": 6, "height": 6}
        },
        {
          "widget": {
            "name": "table_portfolio",
            "title": "Project Portfolio",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "portfolio_completion",
                  "fields": [
                    {"name": "project_name", "expression": "`project_name`"},
                    {"name": "value_m", "expression": "`value_m`"},
                    {"name": "pct_complete", "expression": "`pct_complete`"},
                    {"name": "status", "expression": "`status`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {"fieldName": "project_name", "displayName": "Project"},
                  {"fieldName": "value_m", "displayName": "Value ($M)"},
                  {"fieldName": "pct_complete", "displayName": "% Complete"},
                  {"fieldName": "status", "displayName": "Status"}
                ]
              }
            }
          },
          "position": {"x": 0, "y": 14, "width": 6, "height": 8}
        }
      ]
    }
  ]
}
