{
  "datasets": [
    {
      "name": "recordable_ytd",
      "displayName": "Recordable YTD",
      "query": "SELECT COUNT(*) AS count FROM css_genie.safety_compliance.incidents WHERE osha_recordable = true AND year(incident_date) = year(current_date())"
    },
    {
      "name": "expired_certs",
      "displayName": "Expired Certs",
      "query": "SELECT COUNT(*) AS count FROM css_genie.safety_compliance.certifications WHERE status = 'expired'"
    },
    {
      "name": "expiring_certs",
      "displayName": "Expiring Soon",
      "query": "SELECT COUNT(*) AS count FROM css_genie.safety_compliance.certifications WHERE status = 'expiring_soon'"
    },
    {
      "name": "incidents_by_type",
      "displayName": "Incidents by Type",
      "query": "SELECT incident_type, COUNT(*) AS total FROM css_genie.safety_compliance.incidents GROUP BY incident_type ORDER BY total DESC"
    },
    {
      "name": "inspection_scores",
      "displayName": "Inspection Scores",
      "query": "SELECT p.project_name, ROUND(AVG(si.overall_score),1) AS avg_score FROM css_genie.safety_compliance.safety_inspections si JOIN css_genie.project_tracking.projects p ON si.project_id = p.project_id WHERE si.inspection_date >= date_sub(current_date(), 90) GROUP BY p.project_name ORDER BY avg_score DESC"
    },
    {
      "name": "cert_status",
      "displayName": "Cert Status",
      "query": "SELECT cert_type, status, COUNT(*) AS count FROM css_genie.safety_compliance.certifications GROUP BY cert_type, status ORDER BY cert_type"
    }
  ],
  "pages": [
    {
      "name": "safety",
      "displayName": "Safety & Compliance",
      "layout": [
        {
          "widget": {
            "name": "w_recordable",
