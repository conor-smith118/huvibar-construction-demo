{
  "datasets": [
    {
      "name": "kpi_trir",
      "displayName": "TRIR YTD",
      "query": "SELECT ROUND(COUNT(CASE WHEN osha_recordable=true THEN 1 END)*200000.0/NULLIF(SUM(ml.total_hours),0),2) AS trir FROM css_genie.safety_compliance.incidents i CROSS JOIN (SELECT SUM(total_hours) AS total_hours FROM css_genie.scheduling.daily_manpower_log WHERE year(log_date)=year(current_date())) ml WHERE year(i.incident_date)=year(current_date())"
    },
    {
      "name": "kpi_recordable",
      "displayName": "Recordable YTD",
      "query": "SELECT COUNT(*) AS recordable FROM css_genie.safety_compliance.incidents WHERE osha_recordable=true AND year(incident_date)=year(current_date())"
    },
    {
      "name": "kpi_expired",
      "displayName": "Expired Certs",
      "query": "SELECT COUNT(*) AS expired FROM css_genie.safety_compliance.certifications WHERE status='expired'"
    },
    {
      "name": "kpi_insp_score",
      "displayName": "Avg Inspection Score",
      "query": "SELECT ROUND(AVG(overall_score),1) AS avg_score FROM css_genie.safety_compliance.safety_inspections WHERE inspection_date >= date_sub(current_date(),90)"
    },
    {
      "name": "incidents_type",
      "displayName": "Incidents by Type",
      "query": "SELECT incident_type, COUNT(*) AS total, SUM(CASE WHEN osha_recordable=true THEN 1 ELSE 0 END) AS recordable FROM css_genie.safety_compliance.incidents GROUP BY incident_type ORDER BY total DESC"
    },
    {
      "name": "insp_by_proj",
      "displayName": "Inspection Scores",
      "query": "SELECT p.project_name, ROUND(AVG(si.overall_score),1) AS avg_score, COUNT(*) AS inspections FROM css_genie.safety_compliance.safety_inspections si JOIN css_genie.project_tracking.projects p ON si.project_id=p.project_id WHERE si.inspection_date >= date_sub(current_date(),90) GROUP BY p.project_name ORDER BY avg_score DESC"
    },
    {
      "name": "monthly_inc",
      "displayName": "Monthly Incidents",
      "query": "SELECT date_format(date_trunc('month',incident_date),'yyyy-MM') AS month, COUNT(*) AS total, SUM(CASE WHEN osha_recordable=true THEN 1 ELSE 0 END) AS recordable FROM css_genie.safety_compliance.incidents WHERE incident_date >= add_months(current_date(),-18) GROUP BY month ORDER BY month"
    },
    {
      "name": "cert_by_type",
      "displayName": "Certs by Type/Status",
      "query": "SELECT cert_type, status, COUNT(*) AS cnt FROM css_genie.safety_compliance.certifications GROUP BY cert_type, status ORDER BY cert_type, status"
    },
    {
      "name": "talks_by_proj",
      "displayName": "Toolbox Talks",
      "query": "SELECT p.project_name, COUNT(*) AS talk_count, SUM(t.attendee_count) AS total_attendees FROM css_genie.safety_compliance.toolbox_talks t JOIN css_genie.project_tracking.projects p ON t.project_id=p.project_id WHERE p.status='active' GROUP BY p.project_name ORDER BY talk_count DESC"
    },
    {
      "name": "severity_split",
      "displayName": "Incident Severity",
      "query": "SELECT severity, COUNT(*) AS cnt FROM css_genie.safety_compliance.incidents GROUP BY severity ORDER BY cnt DESC"
    }
  ],
