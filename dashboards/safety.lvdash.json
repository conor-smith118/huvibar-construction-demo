{
  "datasets": [
    {
      "name": "kpi_trir",
      "displayName": "TRIR YTD",
      "queryLines": [
        "SELECT ROUND(COUNT(CASE WHEN osha_recordable=true THEN 1 END)*200000.0/NULLIF(SUM(ml.total_hours),0),2) AS trir FROM css_genie.safety_compliance.incidents i CROSS JOIN (SELECT SUM(total_hours) AS total_hours FROM css_genie.scheduling.daily_manpower_log WHERE year(log_date)=year(current_date())) ml WHERE year(i.incident_date)=year(current_date())"
      ]
    },
    {
      "name": "kpi_rec",
      "displayName": "Recordable Incidents",
      "queryLines": [
        "SELECT COUNT(*) AS recordable FROM css_genie.safety_compliance.incidents WHERE osha_recordable=true AND year(incident_date)=year(current_date())"
      ]
    },
    {
      "name": "kpi_exp",
      "displayName": "Expired Certifications",
      "queryLines": [
        "SELECT COUNT(*) AS expired FROM css_genie.safety_compliance.certifications WHERE status='expired'"
      ]
    },
    {
      "name": "kpi_score",
      "displayName": "Avg Inspection Score",
      "queryLines": [
        "SELECT ROUND(AVG(overall_score),1) AS avg_score FROM css_genie.safety_compliance.safety_inspections WHERE inspection_date>=date_sub(current_date(),90)"
      ]
    },
    {
      "name": "inc_type",
      "displayName": "Incidents by Type",
      "queryLines": [
        "SELECT incident_type, COUNT(*) AS total FROM css_genie.safety_compliance.incidents GROUP BY incident_type ORDER BY total DESC"
      ]
    },
    {
      "name": "severity",
      "displayName": "Incident Severity",
      "queryLines": [
        "SELECT severity, COUNT(*) AS cnt FROM css_genie.safety_compliance.incidents GROUP BY severity ORDER BY cnt DESC"
      ]
    },
    {
      "name": "monthly_inc",
      "displayName": "Monthly Incidents",
      "queryLines": [
        "SELECT date_format(date_trunc('month',incident_date),'yyyy-MM') AS month, COUNT(*) AS total FROM css_genie.safety_compliance.incidents WHERE incident_date>=add_months(current_date(),-18) GROUP BY month ORDER BY month"
      ]
    },
    {
      "name": "insp_scores",
      "displayName": "Inspection Scores",
      "queryLines": [
        "SELECT p.project_name, ROUND(AVG(si.overall_score),1) AS avg_score FROM css_genie.safety_compliance.safety_inspections si JOIN css_genie.project_tracking.projects p ON si.project_id=p.project_id WHERE si.inspection_date>=date_sub(current_date(),90) GROUP BY p.project_name ORDER BY avg_score DESC"
      ]
    },
    {
      "name": "talks",
      "displayName": "Toolbox Talks",
      "queryLines": [
        "SELECT p.project_name, COUNT(*) AS talk_count FROM css_genie.safety_compliance.toolbox_talks t JOIN css_genie.project_tracking.projects p ON t.project_id=p.project_id WHERE p.status='active' GROUP BY p.project_name ORDER BY talk_count DESC"
      ]
    },
    {
      "name": "certs",
      "displayName": "Cert Status",
      "queryLines": [
        "SELECT cert_type, status, COUNT(*) AS cnt FROM css_genie.safety_compliance.certifications GROUP BY cert_type, status ORDER BY cert_type, status"
      ]
    }
  ],
